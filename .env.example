# Exemplo para execucao sem docker-compose (o entrypoint.sh usa como fallback;
# VISITORPASS_DB_HOST e sobrescrito pelo environment do compose).
# Troque VISITORPASS_DB_PASS por uma senha real: em producao ela e obrigatoria
# e o compose falha de proposito se ela nao estiver definida no .env.
VISITORPASS_DB_HOST=db
VISITORPASS_DB_NAME=visitorpass
VISITORPASS_DB_USER=vpuser
VISITORPASS_DB_PASS=troque-esta-senha
VISITORPASS_SESSION_TIMEOUT=3600
VISITORPASS_SESSION_ABSOLUTE_LIFETIME=43200
