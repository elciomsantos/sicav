# Nome do projeto Compose (prefixo dos containers e redes).
# Use um valor diferente para cada instância/sistema no mesmo servidor.
COMPOSE_PROJECT_NAME=visitantes

# Porta externa do sistema (container nginx -> app:80). Escolha outra porta
# se este servidor hospedar mais de um sistema.
NGINX_PORT=8000

# Ambiente: production | development
APP_ENV=development

# Configuracao do banco de dados
VISITORPASS_DB_NAME=visitorpass
VISITORPASS_DB_USER=vpuser
VISITORPASS_DB_PASS=visitorpassword

# Senha root do MySQL (use uma senha forte em producao!)
MYSQL_ROOT_PASSWORD=rootpassword

# Portas
DB_PORT=3307
PMA_PORT=8081

# Sessao (em segundos)
VISITORPASS_SESSION_TIMEOUT=3600
