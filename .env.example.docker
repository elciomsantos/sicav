# Nome do projeto Compose (prefixo dos containers e redes).
# Use um valor diferente para cada instância/sistema no mesmo servidor.
COMPOSE_PROJECT_NAME=visitantes

# Porta externa do sistema (container nginx -> app:80). Escolha outra porta
# se este servidor hospedar mais de um sistema.
NGINX_PORT=8000

# Ambiente: production | development
# Em desenvolvimento, sobrescreva na linha de comando: APP_ENV=development docker compose ...
APP_ENV=production

# Versao exibida no badge do rodape (use a tag de release, ex.: v1.0.1)
VISITORPASS_APP_VERSION=v1.0.0

# Configuracao do banco de dados
VISITORPASS_DB_NAME=visitorpass
VISITORPASS_DB_USER=vpuser

# OBRIGATORIAS em producao: o "docker compose" falha sem estas variaveis
# (nao existe mais fallback de senha fraca). Use senhas longas e aleatorias.
VISITORPASS_DB_PASS=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Portas
PMA_PORT=8081

# Sessao (em segundos)
VISITORPASS_SESSION_TIMEOUT=3600
VISITORPASS_SESSION_ABSOLUTE_LIFETIME=43200

# Backup (scripts/backup.sh + deploy/visitantes-backup.timer)
# BACKUP_DIR deve ficar em OUTRO disco/host para proteger contra perda do drive.
BACKUP_DIR=/mnt/visitantes/backups
# Obrigatorio para o backup: chave publica GPG ja importada no keyring do usuario
# que roda o timer. O backup recusa rodar sem destinatario (dados tem PII).
# BACKUP_GPG_RECIPIENT=backup@exemplo.com
# Copia para outro host (descomente depois de configurar a chave SSH):
# BACKUP_REMOTE=backup@outro-host:/srv/sicav/backups
BACKUP_KEEP_DAYS=7
